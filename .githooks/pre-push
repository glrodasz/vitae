#!/bin/sh
set -e

yarn validate:content

echo "Running generate:readme and generate:resume-md before push..."

yarn generate:readme
yarn generate:resume-md

if ! git diff --quiet README.md resume.md; then
  echo ""
  echo "ERROR: README.md or resume.md was regenerated but not committed."
  echo ""
  echo "Please commit the updated files and then push again:"
  echo ""
  echo "  git add README.md resume.md"
  echo "  git commit -m 'docs: update generated README and resume'"
  echo "  git push"
  echo ""
  exit 1
fi

echo "README.md and resume.md are up to date. Proceeding with push."
exit 0
